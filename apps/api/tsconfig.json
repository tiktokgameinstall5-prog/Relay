{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    // Explicit rather than inferred: ts-jest compiles each file in isolation
    // and does not always pick up @types from the workspace root, which shows
    // up as "Cannot find name 'describe'" only under the test runner.
    "types": ["node", "jest"],
    // Relative form ("./src/*", not "src/*"): TypeScript 6 deprecated baseUrl,
    // and without it path mappings must be explicitly relative to this file.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
