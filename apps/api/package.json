{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "db:check": "tsx --env-file-if-exists=.env src/db/scripts/check-db.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/scripts/migrate.ts",
    "db:setup:supabase": "tsx src/db/scripts/setup-supabase.ts",
    "db:superuser": "tsx --env-file-if-exists=.env src/db/scripts/create-superuser.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/scripts/seed-dev.ts",
    "db:generate": "drizzle-kit generate",
    "mail:test": "tsx --env-file-if-exists=.env src/mail/scripts/test-mail.ts",
    "test": "jest",
    "test:e2e": "node --env-file-if-exists=.env ../../node_modules/jest/bin/jest.js --config jest.e2e.config.ts --runInBand",
    "test:isolation": "node --env-file-if-exists=.env ../../node_modules/jest/bin/jest.js --config jest.e2e.config.ts --runInBand --testPathPatterns \"(isolation|rls)\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@supabase/supabase-js": "^2.115.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3"
  }
}
