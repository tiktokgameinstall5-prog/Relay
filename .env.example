# ---------------------------------------------------------------------------
# Relay API — copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Database -------------------------------------------------------------
# Two roles by design (see plan §3). The API MUST connect as relay_app, which
# does not own the tables — table owners bypass RLS unless FORCE is set, so
# running the API as the migrator would silently disable every policy.

# Runtime connection used by the API. Subject to row-level security.
DATABASE_URL=postgresql://relay_app:app_local_pw@localhost:55432/relay

# Migration connection. Owns the schema, runs DDL. Never used at runtime.
MIGRATION_DATABASE_URL=postgresql://relay_migrator:migrator_local_pw@localhost:55432/relay

# Embedded Postgres (local dev only — no Docker/psql needed on this machine).
# If DATABASE_URL points at a real server, these are ignored.
EMBEDDED_PG_PORT=55432
EMBEDDED_PG_DATA_DIR=.pgdata
EMBEDDED_PG_SUPERUSER=postgres
EMBEDDED_PG_SUPERUSER_PASSWORD=postgres_local_pw

# --- JWT ------------------------------------------------------------------
# Generate real secrets with: openssl rand -base64 48
# Access and refresh MUST use different secrets so a leaked access secret
# cannot be used to mint refresh tokens.
JWT_ACCESS_SECRET=replace-me-with-48-bytes-of-base64-randomness
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-48-bytes-of-randomness
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Passcodes ------------------------------------------------------------
PASSCODE_TTL_HOURS=72
BCRYPT_COST=12

# --- Mail -----------------------------------------------------------------
# console = print invite emails to stdout (dev). smtp = real delivery.
# The console driver prints passcodes; it must never be enabled in production.
MAIL_DRIVER=console
MAIL_FROM="Relay <no-reply@relay.local>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- App ------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
