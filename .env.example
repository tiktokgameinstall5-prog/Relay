# ---------------------------------------------------------------------------
# Relay API — copy to apps/api/.env and fill in. NEVER commit the real .env.
#
# First-time setup (once per machine):
#   1. Install PostgreSQL 17 and make sure the service is running.
#   2. Create the database and the two roles:
#        psql -h localhost -U postgres -d postgres \
#          -v migrator_password="'...'" -v app_password="'...'" \
#          -f apps/api/src/db/scripts/bootstrap.sql
#   3. Put those same two passwords in the URLs below.
#   4. npm --workspace apps/api run db:migrate
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Database -------------------------------------------------------------
# Two roles by design (see plan §3). The API MUST connect as relay_app, which
# does not own the tables — a table owner bypasses row-level security unless
# FORCE is set, so running the API as the migrator would silently disable
# every isolation policy. relay_app also must never hold the BYPASSRLS
# attribute; bootstrap.sql spells this out explicitly.

# Runtime connection used by the API. Subject to row-level security.
DATABASE_URL=postgresql://relay_app:REPLACE_ME@localhost:5432/relay

# Migration connection. Owns the schema, runs DDL. Never used at runtime.
MIGRATION_DATABASE_URL=postgresql://relay_migrator:REPLACE_ME@localhost:5432/relay

# Used by the db:up / db:down helper scripts to find the local service.
PGHOST=localhost
PGPORT=5432

# --- JWT ------------------------------------------------------------------
# Generate real secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Access and refresh MUST use different secrets so a leaked access secret
# cannot be used to mint refresh tokens.
JWT_ACCESS_SECRET=replace-me-with-48-bytes-of-base64-randomness
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-48-bytes-of-randomness
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Passcodes ------------------------------------------------------------
PASSCODE_TTL_HOURS=72
BCRYPT_COST=12

# --- Mail -----------------------------------------------------------------
# console = print invite emails to stdout (dev). smtp = real delivery.
# The console driver prints passcodes; it must never be enabled in production.
MAIL_DRIVER=console
MAIL_FROM="Relay <no-reply@relay.local>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- App ------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# Interactive API docs (Swagger UI) at /api/docs.
#
# Defaults to on outside production, off in it — so leaving this unset is the
# correct choice in both. Set it explicitly only to override that.
#
# The page is UNAUTHENTICATED: Swagger mounts Express middleware, so the global
# JwtAuthGuard never sees those requests. It also lists every route, DTO field,
# and validation rule. Fine on a dev machine, reconnaissance on a public host.
# API_DOCS_ENABLED=true
