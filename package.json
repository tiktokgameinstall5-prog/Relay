{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "Relay — multi-tenant team workspace & sequential task-handoff platform",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm --workspace apps/api run start:dev",
    "build": "npm --workspace apps/api run build",
    "db:check": "npm --workspace apps/api run db:check",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "test": "npm --workspace apps/api run test",
    "test:e2e": "npm --workspace apps/api run test:e2e",
    "test:isolation": "npm --workspace apps/api run test:isolation"
  }
}
