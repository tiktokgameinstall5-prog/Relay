{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "Relay — multi-tenant team workspace & sequential task-handoff platform",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "scripts": {
    "dev": "npm --workspace apps/api run start:dev",
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build && npm --workspace apps/api run build",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "db:check": "npm --workspace apps/api run db:check",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:setup:supabase": "npm --workspace apps/api run db:setup:supabase",
    "db:superuser": "npm --workspace apps/api run db:superuser",
    "mail:test": "npm --workspace apps/api run mail:test",
    "test": "npm --workspace apps/api run test",
    "test:e2e": "npm --workspace apps/api run test:e2e",
    "test:isolation": "npm --workspace apps/api run test:isolation",
    "test:web": "npm --workspace apps/web run test"
  }
}
